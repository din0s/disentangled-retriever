#!/bin/bash

#SBATCH --partition=shared
#SBATCH --gres=gpu:0
#SBATCH --job-name=DownloadBEIR
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=06:00:00
#SBATCH --mem=64gb
#SBATCH --array=1-1%1
#SBATCH --output=out/slurm_download_%A_%a.out

module purge
module load 2022
module load Anaconda3/2022.05
module load Java/11.0.16
source activate thesis

ROOT=$HOME/disentangled-retriever
TARGET=$ROOT/data/datasets
HPARAMS=$ROOT/jobs/hparams_download.txt

mkdir -p "$TMPDIR/datasets" && cd "$_"
echo "Downloading datasets."
python -u $ROOT/src/download_data.py \
    --download_all \
    $(head -$SLURM_ARRAY_TASK_ID $HPARAMS | tail -1)

echo "Copying to root directory."
mkdir -p $TARGET && cp -a . $TARGET

